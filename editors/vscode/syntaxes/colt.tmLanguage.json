{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Colt",
  "scopeName": "source.colt",
  "patterns": [
    { "include": "#comments" },
    { "include": "#shebang" },
    { "include": "#pragma" },
    { "include": "#strings" },
    { "include": "#parameters" },
    { "include": "#record_id" },
    { "include": "#annotations" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#engines" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.colt",
          "match": "--.*$"
        },
        {
          "name": "comment.block.colt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "shebang": {
      "patterns": [
        {
          "name": "comment.line.shebang.colt",
          "match": "^#!.*$"
        }
      ]
    },
    "pragma": {
      "patterns": [
        {
          "match": "(#colt)\\s+([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
          "captures": {
            "1": { "name": "keyword.control.directive.pragma.colt" },
            "2": { "name": "constant.numeric.version.colt" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.colt",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.colt",
              "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.colt",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "record_id": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*):([a-zA-Z0-9_\\-]+)\\b",
          "captures": {
            "1": { "name": "entity.name.type.collection.colt" },
            "2": { "name": "constant.other.record-key.colt" }
          }
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.annotation.colt",
          "match": "@[a-zA-Z_][a-zA-Z0-9_.]*"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.colt",
          "match": "\\b(?i:true|false)\\b"
        },
        {
          "name": "constant.language.null.colt",
          "match": "\\b(?i:null)\\b"
        },
        {
          "name": "constant.numeric.duration.colt",
          "match": "\\b[0-9]+(?:s|m|h|d)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.declaration.colt",
          "match": "\\b(?i:CONNECT|AS|DEFAULT|CONNECTION|DEFINE|COLLECTION|STRICT|FLEXIBLE|MELD|LINK|SYNC|CONSTRAINT|REFERENCES|MODE|VECTORIZE|STREAM|MASK|REDACT|EXPIRE|CASCADE|RESOLVE|FALLBACK|FOR|ROLE|WITH|TIMEOUT|USING)\\b"
        },
        {
          "name": "keyword.control.query.colt",
          "match": "\\b(?i:FIND|SELECT|WHERE|ORDER|BY|ASC|DESC|LIMIT|OFFSET|FETCH|LIVE|NEAREST|SINCE|WINDOW|TO|KEY|TTL)\\b"
        },
        {
          "name": "keyword.control.mutation.colt",
          "match": "\\b(?i:PUT|CREATE|DELETE|ATOMIC|SAGA|POLICY|UPDATE|MERGE|SET|GET|RELATE|EDGE)\\b"
        }
      ]
    },
    "engines": {
      "patterns": [
        {
          "name": "support.class.engine.colt",
          "match": "\\b(?i:postgres|redis|mongodb|sqlite|libsql|firestore|d1)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.colt",
          "match": "\\b(?i:uuid|text|int|float|bool|time|duration|doc|list|link|vector)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.colt",
          "match": "\\b(?i:env|now|count|sum|avg|min|max)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.colt",
          "match": "\\b-?[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.colt",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.colt",
          "match": "\\b(?i:AND|OR|NOT|IN)\\b"
        },
        {
          "name": "keyword.operator.comparison.colt",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arrow.colt",
          "match": "->|<-"
        },
        {
          "name": "keyword.operator.arithmetic.colt",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    }
  }
}
