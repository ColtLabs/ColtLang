# .colt.env.example
# Copy this file to .colt.env and configure your local or provider database URLs.
# WARNING: NEVER commit .colt.env to source control! It is ignored by .gitignore.

DATABASE_URL="postgresql://user:password@localhost:5432/colt"
REDIS_URL="redis://default:token@localhost:6379"
MONGODB_URL="mongodb://localhost:27017/colt"
