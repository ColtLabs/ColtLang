{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "server.ts",
      "buildCommand": "pnpm build",
      "installCommand": "pnpm install --frozen-lockfile",
      "bindings": [
        {
          "type": "service",
          "service": "python",
          "format": "url",
          "env": "PYTHON_SERVICE_URL"
        }
      ]
    },
    "python": {
      "root": "python",
      "runtime": "python",
      "entrypoint": "index.py"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
