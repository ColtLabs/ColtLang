<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-colt">
    <comment>Colt Database Source File</comment>
    <comment xml:lang="en">Colt Database Source File</comment>
    <glob pattern="*.colt"/>
    <magic priority="50">
      <match type="string" offset="0" value="#!/usr/bin/env colt"/>
      <match type="string" offset="0" value="#colt"/>
    </magic>
  </mime-type>
</mime-info>
