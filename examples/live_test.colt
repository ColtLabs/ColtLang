#colt 0.2

-- 1. Connection Endpoints
CONNECT main AS postgres(env("DATABASE_URL"))
CONNECT cache AS redis(env("REDIS_URL"))

DEFAULT CONNECTION main

-- 2. Collections on PostgreSQL
DEFINE COLLECTION authors STRICT {
  id: uuid @key,
  name: text @unique,
  joined: time @default(now)
}

DEFINE COLLECTION books STRICT {
  id: uuid @key,
  title: text,
  author: link<authors>,
  tags: list<text>,
  published: time?,
  metadata: doc,
  embedding: vector(3) @index(hnsw),
  views: int @default(0)
}

-- 3. Ephemeral Collection on Redis Cache
DEFINE COLLECTION sessions @backend(cache) @ttl(30m) {
  id: uuid @key,
  token: text
}

-- 4. Data Entry: Authors and Books (Postgres)
PUT authors:22222222-2222-4222-8222-222222222222 {
  name: "Ursula K. Le Guin"
}

PUT books:11111111-1111-4111-8111-111111111111 {
  title: "The Left Hand of Darkness",
  author: authors:22222222-2222-4222-8222-222222222222,
  tags: ["science-fiction", "classic"],
  metadata: { edition: 3, language: "en" },
  embedding: [0.12, -0.4, 0.88],
  views: 42
}

-- 5. Data Entry: Session (Redis)
PUT sessions:33333333-3333-4333-8333-333333333333 {
  token: "sess_live_test_token_999"
}

-- 6. Data Fetch: Query with Filter and Projection
FIND books SELECT title, author, views, metadata.edition
WHERE views > 10
ORDER BY views DESC
LIMIT 10
