{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["*.ts", "src/**/*.ts", "apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
